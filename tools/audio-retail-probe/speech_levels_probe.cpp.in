 for(int tick=0;tick<4096;tick++){
  int kind=tick%2,s100=(tick/2)%2,s104=(tick/4)%6,s112=(tick/24)%2,security=(tick/48)%2,event=(tick/96)%2?8277:8210,far_clip=(tick/192)%2,model=(tick/384)%4==0?29:(tick/384)%4==1?30:(tick/384)%4==2?40:41;
  uint32_t speaker_id=43,focus_id=(tick/768)%2==0?(kind?model:speaker_id):999,active=(tick/1536)%2;
  REX_STORE_U32(0x20000+1036,focus_id);REX_STORE_U8(0x20000+1053,active);
  memset(base+owner+36,0,160);REX_STORE_U32(owner+32,record);
  REX_STORE_U8(owner+(kind?117:113),far_clip);REX_STORE_U32(owner+(kind?152:156),1);
  REX_STORE_U16(owner+100,event);
  REX_STORE_U32(record+100,s100);REX_STORE_U32(record+104,s104);REX_STORE_U32(record+112,s112);
  REX_STORE_U32(record+96,security?64:0);REX_STORE_U32(record+84,speaker_id);REX_STORE_U32(record+76,model);
  PPCContext ctx{};ctx.fpscr.loadFromHost();ctx.r1.u32=0x40000;ctx.r3.u32=owner;
  if(kind)sub_824DA300(ctx,base);else sub_824D9370(ctx,base);
  fprintf(out,"%d %d %d %d %d %d %d %d %u %u %u %u %u\n",kind,s100,s104,s112,security,event,far_clip,model,active,focus_id,speaker_id,REX_LOAD_U32(owner+(kind?56:52))-1000,REX_LOAD_U32(owner+(kind?80:76))-1000);
 }
 fclose(out);return 0;
}
