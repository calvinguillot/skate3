 FILE*out=fopen(argv[2],"w");if(!out)return 5;fprintf(out,"# TU3 ambience 824D3C28 824D3FE0 824D41E0; desired dt current phase out_timer in_timer input start_bed stop_bed start_fade stop_fade\n");
 for(int tick=0;tick<2048;tick++){
  desired=tick<100?1:tick<130?2:tick<260?1:tick<420?2:tick<600?0:tick<700?3:tick<900?1:((tick/13)%4);
  float dt=tick<1024?1.f/30:tick%4==0?0.f:tick%4==1?1.f/60:tick%4==2?0.1f:0.25f;
  start_bed=stop_bed=start_fade=stop_fade=0;
  PPCContext ctx{};ctx.fpscr.loadFromHost();ctx.r1.u32=0x40000;ctx.r3.u32=0x20000;ctx.f1.f64=dt;sub_824D3C28(ctx,base);
  fprintf(out,"%llu %08x %llu %u %08x %08x %d %d %d %d %d\n",desired,std::bit_cast<uint32_t>(dt),REX_LOAD_U64(0x20030),REX_LOAD_U32(0x20040),REX_LOAD_U32(0x20044),REX_LOAD_U32(0x20048),input_word,start_bed,stop_bed,start_fade,stop_fade);
 }
 fclose(out);return 0;
}
