// @RETAIL_FUNCTION_829531F8@
LONG CALLBACK fault(EXCEPTION_POINTERS*p){fprintf(stderr,"probe fault in %s code %08lx guest-ref %llx\n",current_function,p->ExceptionRecord->ExceptionCode,p->ExceptionRecord->ExceptionInformation[1]);ExitProcess(8);return EXCEPTION_EXECUTE_HANDLER;}
int main(int argc,char**argv){
 SetErrorMode(SEM_FAILCRITICALERRORS|SEM_NOGPFAULTERRORBOX);AddVectoredExceptionHandler(1,fault);
 if(argc!=4)return 2;
 auto base=(uint8_t*)VirtualAlloc(nullptr,0x100000000ull,MEM_RESERVE,PAGE_READWRITE);
 if(!base||!VirtualAlloc(base+0x82000000,0x11b0000,MEM_COMMIT,PAGE_READWRITE)||!VirtualAlloc(base+0x10000,0x1000000,MEM_COMMIT,PAGE_READWRITE))return 3;
 std::ifstream image(argv[1],std::ios::binary);image.read((char*)base+0x82000000,0x11b0000);if(!image)return 4;
 std::ifstream mxb(argv[2],std::ios::binary|std::ios::ate);auto size=mxb.tellg();mxb.seekg(0);mxb.read((char*)base+0x80000,size);if(!mxb)return 5;
 PPCContext ctx{};ctx.fpscr.loadFromHost();ctx.r1.u32=0x70000;
 REX_STORE_U32(0x20000,0x20200);REX_STORE_U32(0x20208,0x100);REX_STORE_U32(0x20204,0x10c);REX_STORE_U32(0x20104,14);REX_STORE_U32(0x20108,0x20300);REX_STORE_U32(0x20300,0x20400);REX_STORE_U32(0x20418,0x104);REX_STORE_U32(0x2041c,0x108);
 ctx.r3.u32=0x20000;ctx.r4.u32=0x20100;sub_8294B918(ctx,base);
 fprintf(stderr,"initialized\n");
 ctx.r3.u32=0x20000;ctx.r4.u32=0x80000;sub_8294BA18(ctx,base);
 auto state=REX_LOAD_U32(0x20008),host=REX_LOAD_U32(state);fprintf(stderr,"built host %08x heap %08x\n",host,bump);

 std::set<uint32_t> spatial;
 auto records=REX_LOAD_U32(host+416);for(uint32_t i=0;i<REX_LOAD_U32(host+468);i++){auto s=REX_LOAD_U32(records+8*i+4);spatial.insert(REX_LOAD_U32(s+4));}
 fprintf(stderr,"spatial blocks %zu\n",spatial.size());
 FILE*out=fopen(argv[3],"wb");if(!out)return 6;
 auto word=[&](uint32_t x){fwrite(&x,4,1,out);};
 fwrite("TU3MXB01",8,1,out);word(controllers.size());word(1024);
 for(auto c:controllers){word(REX_LOAD_U32(c+4));word(REX_LOAD_U32(c+12)!=0);}
 uint32_t rng=0x31fa75c9;
 for(int tick=0;tick<1024;tick++){
  float dt=tick<512?1.0f/30:(tick%4==0?1.0f/60:tick%4==1?1.0f/30:tick%4==2?0.05f:0.1f);
  uint32_t mode=tick<128?0xffffffff:uint32_t((tick/32)%16);word(std::bit_cast<uint32_t>(dt));word(mode);
  for(auto c:controllers){
   auto key=REX_LOAD_U32(c+4),input=REX_LOAD_U32(c+8),output=REX_LOAD_U32(c+12);
   for(int id=0;id<16;id++){
    rng=rng*1664525+1013904223;uint32_t v;
    if(tick<64)v=0;else if(tick<128)v=32767;else if(tick<256)v=(tick/16)%2?32767:0;else v=(rng>>16)&32767;
    if(spatial.contains(input)){
      if(id<=1)v=std::bit_cast<uint32_t>((tick%200)*0.75f+id*2.5f);
      else if(id==2||id==3)v=rng&65535;
      else if(id==13||id==14)v=std::bit_cast<uint32_t>((int(tick%100)-50)*2.5f);
      else if(id==15)v=(tick%41==40)?0:1;
    }
    word(v);if(input)REX_STORE_U32(input+4*id,v);
   }
   uint32_t enabled=tick%127!=126;word(enabled);if(output)REX_STORE_U32(output+60,enabled);
  }
  ctx.r1.u32=0x70000;ctx.r3.u32=host;ctx.r5.u32=mode;ctx.f1.f64=dt;sub_8294F5E8(ctx,base);
  for(auto c:controllers){auto output=REX_LOAD_U32(c+12);for(int id=0;id<16;id++)word(output?REX_LOAD_U32(output+4*id):0);}
 }
 fclose(out);fprintf(stderr,"completed 1024 ticks, %zu controllers\n",controllers.size());return 0;
}
