// @RETAIL_FUNCTION_82971890@
LONG CALLBACK fault(EXCEPTION_POINTERS*p){fprintf(stderr,"queue fault %s code %08lx\n",current_function,p->ExceptionRecord->ExceptionCode);ExitProcess(8);return EXCEPTION_EXECUTE_HANDLER;}
int main(int argc,char**argv){
 SetErrorMode(SEM_FAILCRITICALERRORS|SEM_NOGPFAULTERRORBOX);AddVectoredExceptionHandler(1,fault);
 if(argc!=3)return 2;auto base=(uint8_t*)VirtualAlloc(nullptr,0x100000000ull,MEM_RESERVE,PAGE_READWRITE);
 if(!base||!VirtualAlloc(base+0x82000000,0x11b0000,MEM_COMMIT,PAGE_READWRITE)||!VirtualAlloc(base+0x10000,0x40000,MEM_COMMIT,PAGE_READWRITE))return 3;
 std::ifstream image(argv[1],std::ios::binary);image.read((char*)base+0x82000000,0x11b0000);if(!image)return 4;
 REX_STORE_U32(0x83080000+17180+8,0);REX_STORE_U32(0x83070000-572,100000);
 for(int ch=0;ch<4;ch++)REX_STORE_U32(0x83070000-604+ch*4,0);
 FILE*out=fopen(argv[2],"w");if(!out)return 5;fprintf(out,"# TU3 speech_queue 82971890; channel,16*(active channel timeout priority age sequence), selected active_mask\n");
 uint32_t seed=0x924af;auto rng=[&](){seed^=seed<<13;seed^=seed>>17;seed^=seed<<5;return seed;};
 for(int tick=0;tick<4096;tick++){
  uint32_t channel=tick%4;fprintf(out,"%u",channel);
  for(uint32_t i=0;i<16;i++){
   uint32_t active=rng()%4!=0,ch=rng()%4,timeout=(rng()%7==0)?0:rng()%256,priority=tick%7==0?10:rng()%5,age=rng()%300,sequence=rng()&65535;
   // Dense equal-priority/equal-age ties and exact timeout edges.
   if(tick%5==0){active=1;ch=channel;age=20;timeout=20+(i%3==0?0:1);}
   uint32_t q=0x83070000-416+64+i*20,e=0x20000+i*32;
   REX_STORE_U32(q,100000-age);REX_STORE_U16(q+4,sequence);REX_STORE_U8(q+6,active);REX_STORE_U8(q+7,ch);REX_STORE_U32(q+8,e);REX_STORE_U16(e,i+1);REX_STORE_U16(e+2,timeout);REX_STORE_U16(e+4,priority);REX_STORE_U8(e+10,0);
   fprintf(out," %u %u %u %u %u %u",active,ch,timeout,priority,age,sequence);
  }
  PPCContext ctx{};ctx.fpscr.loadFromHost();ctx.r1.u32=0x40000;ctx.r3.u32=0;ctx.r4.u32=channel;sub_82971890(ctx,base);
  uint32_t mask=0;for(uint32_t i=0;i<16;i++)if(REX_LOAD_U8(0x83070000-416+70+i*20))mask|=1<<i;
  fprintf(out," %d %u\n",ctx.r3.s32,mask);
 }
 fclose(out);return 0;
}
